<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same exclusion as backup_rules.xml, for cloud backups and for
     device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
