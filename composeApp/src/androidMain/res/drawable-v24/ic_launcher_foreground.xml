<?xml version="1.0" encoding="utf-8"?>
<!-- A folded map, in the same family as the AdventureLog project's own mark but drawn for this
     client and in its palette.
     Everything sits inside the 72dp safe zone (18..90), so no launcher mask - circle, squircle or
     rounded square - can clip it. Detail is deliberately sparse: at 48dp on a home screen, fold
     lines and a single marker are all that survive. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The map itself: three panels, alternately folded up and down. -->
    <path
        android:pathData="M26,40 L45,31 L63,40 L82,31 L82,71 L63,80 L45,71 L26,80 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- The two creases, drawn in the background teal so they read as folds rather than lines. -->
    <path
        android:pathData="M45,31 L45,71"
        android:strokeColor="#FF006973"
        android:strokeWidth="1.6"
        android:strokeAlpha="0.35" />
    <path
        android:pathData="M63,40 L63,80"
        android:strokeColor="#FF006973"
        android:strokeWidth="1.6"
        android:strokeAlpha="0.35" />

    <!-- The route, ending at the marker rather than wandering off the panel. -->
    <path
        android:pathData="M33,69 C40,57 48,66 55,55 C60,47 65,52 70,47"
        android:strokeColor="#FF006973"
        android:strokeWidth="2.8"
        android:strokeAlpha="0.45"
        android:strokeLineCap="round" />

    <!-- One marker, sitting wholly inside the third panel so nothing overhangs the fold. -->
    <path
        android:pathData="M72,39.5 C75.6,39.5 78.5,42.4 78.5,46 C78.5,50.9 72,58 72,58 C72,58 65.5,50.9 65.5,46 C65.5,42.4 68.4,39.5 72,39.5 Z"
        android:fillColor="#FF006973" />
    <path
        android:pathData="M72,45.6 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0"
        android:fillColor="#FF9EEFFC" />
</vector>
